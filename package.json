{
  "name": "julie-scents",
  "version": "1.0.0",
  "private": true,
  "description": "Julie Scents — demo storefront for a designer perfume retailer with in-house fragrance recreations.",
  "scripts": {
    "start": "npx --yes serve . -l 4173",
    "check": "node tools/validate.mjs && node tools/test-commerce.mjs",
